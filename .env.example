# Copy the values into your shell or hosting provider. Never commit real keys.
# The server reads the process environment; it does not load this file.

# Data artifacts
MEAL_CATALOG_INDEX=data/processed/singapore-catalog-v1.sqlite
MEAL_SERVING_INDEX=data/processed/singapore-serving-v1.sqlite

# LLM routing: primary provider plus ordered fallbacks.
# Providers: gemini | groq | local | openai | disabled
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.1-flash-lite
LLM_FALLBACK_PROVIDERS=groq

# Google Gemini (free tier from Google AI Studio)
GEMINI_API_KEY=
GEMINI_CALLS_PER_MINUTE=4
GEMINI_CALLS_PER_DAY=20

# Groq (free tier, OpenAI-compatible, open models)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_CALLS_PER_MINUTE=20
GROQ_CALLS_PER_DAY=500

# Local llama.cpp server running the pinned Qwen model (scripts/fetch_local_llm.py)
LOCAL_LLM_URL=http://127.0.0.1:8081
LOCAL_LLM_MODEL=meal-local

# OpenAI (adapter available, not part of the evaluated free setup)
OPENAI_API_KEY=
OPENAI_MODEL=

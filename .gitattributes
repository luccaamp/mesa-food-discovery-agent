* text=auto
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
# These inference artifacts are byte-hashed; preserve their executed bytes.
/configs/conversation-*.json -text whitespace=cr-at-eol
/evaluations/results/conversation-*.json -text whitespace=cr-at-eol
/evaluations/results/public-assistant-acceptance-v1.json -text whitespace=cr-at-eol
/evaluations/results/usage-*.json -text whitespace=cr-at-eol
/configs/usage-additional-*.json -text whitespace=cr-at-eol

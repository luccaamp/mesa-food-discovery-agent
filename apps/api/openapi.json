  "components": {
    "schemas": {
      "AssistantContext": {
        "properties": {
          "last_query": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Query"
          },
          "region": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-z]{5}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Region",
            "description": "DHRD order region (geohash); see /v1/discovery/regions"
          },
          "cuisine": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Cuisine"
          },
          "min_price": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Min Price"
          },
          "max_price": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Price"
          },
          "price_level": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 3.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Price Level",
            "description": "Keep items up to this price band of their cuisine: 1 = $, 2 = $$, 3 = any priced item"
          },
          "selected_items": {
            "items": {
              "$ref": "#/components/schemas/ItemRef"
            },
            "type": "array",
            "maxItems": 5,
            "title": "Selected Items"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "AssistantContext"
      },
      "AssistantRequest": {
        "properties": {
          "message": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Message"
          },
          "context": {
            "$ref": "#/components/schemas/AssistantContext"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "message"
        ],
        "title": "AssistantRequest"
      },
      "AssistantResponse": {
        "properties": {
          "fallback_reason": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "provider_timeout",
                  "provider_cooldown",
                  "quota",
                  "invalid_response",
                  "provider_unavailable"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Fallback Reason"
          },
          "retry_after_seconds": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Retry After Seconds"
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "needs_clarification",
              "no_results"
            ],
            "title": "Status"
          },
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "items": {
            "items": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/RecommendedItem"
                },
                {
                  "$ref": "#/components/schemas/Item"
                }
              ]
            },
            "type": "array",
            "title": "Items"
          },
          "context": {
            "$ref": "#/components/schemas/AssistantContext"
          },
          "tools": {
            "items": {
              "$ref": "#/components/schemas/ToolTrace"
            },
            "type": "array",
            "title": "Tools"
          },
          "planner": {
            "type": "string",
            "title": "Planner"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          },
          "usage": {
            "additionalProperties": true,
            "type": "object",
            "title": "Usage"
          },
          "elapsed_ms": {
            "type": "number",
            "title": "Elapsed Ms"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          }
        },
        "type": "object",
        "required": [
          "status",
          "answer",
          "items",
          "context",
          "tools",
          "planner",
          "model",
          "usage",
          "elapsed_ms",
          "warnings"
        ],
        "title": "AssistantResponse"
      },
      "Cuisine": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "products": {
            "type": "integer",
            "title": "Products"
          }
        },
        "type": "object",
        "required": [
          "name",
          "products"
        ],
        "title": "Cuisine"
      },
      "CuisinesResult": {
        "properties": {
          "cuisines": {
            "items": {
